              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 4,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"quote_product\",\n    \"arguments\": {\n      \"sku\": \"GIN-DRY\",\n      \"quantityKg\": 2,\n      \"couponCode\": \"WELCOME10\"\n    }\n  }\n}"
