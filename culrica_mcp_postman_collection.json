{
  "info": {
    "_postman_id": "culrica-chord-mcp-phase2",
    "name": "Culrica Commerce & Chord MCP (Phase 2.2)",
    "description": "Complete Postman collection for testing the Culrica remote Streamable HTTP MCP server (all 7 tools) and admin support tickets API on localhost and production.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "mcpToken",
      "value": "0c406b6ada3cade807b977af31a79419a67b7ca4ebd33efd54f4cb3b7b4b86fd",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. MCP Protocol Discovery",
      "item": [
        {
          "name": "MCP: Initialize",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mcpToken}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"initialize\",\n  \"params\": {\n    \"protocolVersion\": \"2024-11-05\",\n    \"capabilities\": {},\n    \"clientInfo\": {\n      \"name\": \"postman\",\n      \"version\": \"1.0.0\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/mcp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mcp"]
            }
          }
        },
        {
          "name": "MCP: List Tools (tools/list)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mcpToken}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/list\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/mcp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mcp"]
            }
          }
        }
      ]
    },
