# ==============================================================================
# CULRICA COMMERCE ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and populate the secrets for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
# Password used to log in at /admin. In development, defaults to 'culrica-demo-2026' if omitted.
ADMIN_PASSWORD=change-to-a-secure-admin-password

# Random 32+ character string used to encrypt & sign session cookies.
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-hex-or-base64-characters

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE (Postgres Storage)
# ------------------------------------------------------------------------------
# In local development: If left blank, Culrica uses local JSON files in data/products.json
# and data/commerce.json.
# In production (e.g., Vercel, Fly.io): REQUIRED, because serverless environments
# do not provide a persistent local filesystem. Run supabase/schema.sql in your Supabase SQL editor.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 3. PAYSTACK PAYMENTS & WEBHOOKS
# ------------------------------------------------------------------------------
# Paystack secret API key used for initializing transactions, verifying payments,
# and validating webhook HMAC-SHA512 signatures.
# Use 'sk_test_...' for staging/testing and 'sk_live_...' for live production.
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Paystack public key (optional, for client-side integrations).
# Use 'pk_test_...' for staging/testing and 'pk_live_...' for live production.
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# ------------------------------------------------------------------------------
# 4. APPLICATION & LOGISTICS SETTINGS
# ------------------------------------------------------------------------------
# The canonical public URL of the application.
# Used for constructing Paystack transaction callback URLs and webhooks.
# Defaults to request origin if omitted.
SITE_URL=http://localhost:3000

# Flat rate dispatch & logistics fee in Nigerian Naira (NGN).
# Set to 0 for free wholesale promo delivery (default: 0).
DELIVERY_FEE_NGN=0

# ------------------------------------------------------------------------------
# 5. CHORD REMOTE MCP AUTHENTICATION (Phase 2)
# ------------------------------------------------------------------------------
# Secret token for machine-to-machine authentication between Chord AI teammate
# and the /api/mcp endpoint. Must be at least 32 characters long.
# Generate one using: openssl rand -hex 32
CHORD_MCP_TOKEN=replace_with_random_secret_at_least_32_characters

